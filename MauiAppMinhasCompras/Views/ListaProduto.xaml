<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppMinhasCompras.Views.ListaProduto"
    Title="Minhas Compras">

    <ContentPage.ToolbarItems>

        <ToolbarItem
            Text="Adicionar"
            Clicked="ToolbarItem_Clicked" />

        <ToolbarItem
            Text="Relatório"
            Clicked="Relatorio_Clicked" />

    </ContentPage.ToolbarItems>

    <Grid
        RowDefinitions="Auto,Auto,Auto,*"
        Padding="12,0">

        <!-- Busca -->
        <SearchBar
            Grid.Row="0"
            x:Name="txt_search"
            Placeholder="Buscar produto"
            TextChanged="txt_search_TextChanged"
            Margin="0,5" />

        <!-- Filtro por categoria -->
        <Picker
            Grid.Row="1"
            x:Name="pck_filtro_categoria"
            Title="Filtrar por categoria"
            SelectedIndexChanged="pck_filtro_categoria_SelectedIndexChanged"
            Margin="0,0,0,10">

            <Picker.Items>
                <x:String>Todas</x:String>
                <x:String>Alimentos</x:String>
                <x:String>Higiene</x:String>
                <x:String>Limpeza</x:String>
            </Picker.Items>

        </Picker>

        <!-- Cabeçalho -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="2*,1.2*,0.8*,1.4*"
            Padding="8,8"
            ColumnSpacing="10">

            <Label
                Grid.Column="0"
                Text="Descrição"
                FontAttributes="Bold" />

            <Label
                Grid.Column="1"
                Text="Preço"
                FontAttributes="Bold"
                HorizontalTextAlignment="End" />

            <Label
                Grid.Column="2"
                Text="Qtd."
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Label
                Grid.Column="3"
                Text="Categoria"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

        </Grid>

        <!-- Produtos -->
        <ListView
            Grid.Row="3"
            x:Name="lst_produtos"
            ItemSelected="lst_produtos_ItemSelected"
            SeparatorVisibility="Default">

            <ListView.ItemTemplate>

                <DataTemplate>

                    <ViewCell>

                        <ViewCell.ContextActions>

                            <MenuItem
                                Text="Remover"
                                Clicked="MenuItem_Clicked"
                                IsDestructive="True" />

                        </ViewCell.ContextActions>

                        <Grid
                            ColumnDefinitions="2*,1.2*,0.8*,1.4*"
                            Padding="8,12"
                            ColumnSpacing="10">

                            <!-- Descrição -->
                            <Label
                                Grid.Column="0"
                                Text="{Binding Descricao}"
                                VerticalTextAlignment="Center" />

                            <!-- Preço -->
                            <Label
                                Grid.Column="1"
                                Text="{Binding Preco, StringFormat='{0:C}'}"
                                HorizontalTextAlignment="End"
                                VerticalTextAlignment="Center" />

                            <!-- Quantidade -->
                            <Label
                                Grid.Column="2"
                                Text="{Binding Quantidade, StringFormat='{0:0.##}'}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                            <!-- Categoria -->
                            <Label
                                Grid.Column="3"
                                Text="{Binding Categoria}"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                        </Grid>

                    </ViewCell>

                </DataTemplate>

            </ListView.ItemTemplate>

        </ListView>

    </Grid>

</ContentPage>